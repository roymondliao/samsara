#!/usr/bin/env bash
# Generated by samsara-cli — do not edit manually.
# Hook: check-codebase-map
# Event: {{ event }}
set -euo pipefail

# Codex runs hooks from the active cwd and also supplies cwd on stdin. Git owns
# repository-root discovery, so this hook does not depend on Claude-only env vars.
cat >/dev/null || true

escape_for_json() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

emit_context() {
    local message="$1"
    local escaped
    escaped=$(escape_for_json "$message")
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$escaped"
}

if ! project_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    emit_context "Codebase Map Status: UNKNOWN. The active directory is not inside a Git repository, so map freshness cannot be verified."
    exit 0
fi

map_file="${project_root}/.samsara/codebase-map.yaml"
if [ ! -f "$map_file" ]; then
    emit_context 'Codebase Map Status: MISSING. No committed snapshot map exists. Use the $codebase-map skill.'
    exit 0
fi

if ! head_commit=$(git -C "$project_root" rev-parse HEAD 2>/dev/null); then
    emit_context "Codebase Map Status: UNKNOWN. Git HEAD cannot be resolved; do not treat the map as current."
    exit 0
fi

schema_version=$(awk '
    /^schema_version:[[:space:]]*/ {
        value = $0
        sub(/^schema_version:[[:space:]]*/, "", value)
        gsub(/["'"'"'[:space:]]/, "", value)
        print value
        exit
    }
' "$map_file")

if [ "$schema_version" != "2" ]; then
    emit_context 'Codebase Map Status: UNKNOWN. The map is not schema version 2; rebuild it with the $codebase-map skill.'
    exit 0
fi

map_commit=$(awk '
    /^source:[[:space:]]*$/ { in_source = 1; next }
    in_source && /^[^[:space:]]/ { in_source = 0 }
    in_source && /^[[:space:]]+commit:[[:space:]]*/ {
        value = $0
        sub(/^[[:space:]]+commit:[[:space:]]*/, "", value)
        gsub(/["'"'"'[:space:]]/, "", value)
        print value
        exit
    }
' "$map_file")

if [ -z "$map_commit" ]; then
    emit_context 'Codebase Map Status: UNKNOWN. source.commit is missing; rebuild the map with the $codebase-map skill.'
    exit 0
fi

if ! git -C "$project_root" cat-file -e "${map_commit}^{commit}" 2>/dev/null; then
    emit_context "Codebase Map Status: UNKNOWN. source.commit '${map_commit}' cannot be resolved by Git; rebuild the map."
    exit 0
fi

if [ "$map_commit" != "$head_commit" ]; then
    emit_context "Codebase Map Status: UPDATE_REQUIRED. The map describes commit ${map_commit}, while committed HEAD is ${head_commit}. Use the \$codebase-map skill. Uncommitted working-tree changes do not affect this state."
fi

exit 0
