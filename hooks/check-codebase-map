#!/usr/bin/env bash
# Compare the Codebase Map source commit with committed Git HEAD.
# CURRENT is silent. MISSING, UPDATE_REQUIRED, and UNKNOWN inject context.

set -euo pipefail

[ -n "${CLAUDE_PROJECT_DIR:-}" ] || exit 0

map_file="${CLAUDE_PROJECT_DIR}/.samsara/codebase-map.yaml"

escape_for_json() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

emit_context() {
    local message="$1"
    local escaped
    escaped=$(escape_for_json "$message")
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
}

if [ ! -f "$map_file" ]; then
    emit_context "Codebase Map Status: MISSING. No committed snapshot map exists. Run /samsara:codebase-map."
    exit 0
fi

if ! git -C "$CLAUDE_PROJECT_DIR" rev-parse --git-dir > /dev/null 2>&1; then
    emit_context "Codebase Map Status: UNKNOWN. The project is not a Git repository, so map freshness cannot be verified."
    exit 0
fi

if ! head_commit=$(git -C "$CLAUDE_PROJECT_DIR" rev-parse HEAD 2>/dev/null); then
    emit_context "Codebase Map Status: UNKNOWN. Git HEAD cannot be resolved; do not treat the map as current."
    exit 0
fi

schema_version=$(awk '
    /^schema_version:[[:space:]]*/ {
        value = $0
        sub(/^schema_version:[[:space:]]*/, "", value)
        gsub(/["'"'"'[:space:]]/, "", value)
        print value
        exit
    }
' "$map_file")

if [ "$schema_version" != "2" ]; then
    emit_context "Codebase Map Status: UNKNOWN. The map is not schema version 2; rebuild it with /samsara:codebase-map."
    exit 0
fi

map_commit=$(awk '
    /^source:[[:space:]]*$/ {
        in_source = 1
        next
    }
    in_source && /^[^[:space:]]/ {
        in_source = 0
    }
    in_source && /^[[:space:]]+commit:[[:space:]]*/ {
        value = $0
        sub(/^[[:space:]]+commit:[[:space:]]*/, "", value)
        gsub(/["'"'"'[:space:]]/, "", value)
        print value
        exit
    }
' "$map_file")

if [ -z "$map_commit" ]; then
    emit_context "Codebase Map Status: UNKNOWN. source.commit is missing; rebuild the map with /samsara:codebase-map."
    exit 0
fi

if ! git -C "$CLAUDE_PROJECT_DIR" cat-file -e "${map_commit}^{commit}" 2>/dev/null; then
    emit_context "Codebase Map Status: UNKNOWN. source.commit '${map_commit}' cannot be resolved by Git; rebuild the map."
    exit 0
fi

if [ "$map_commit" != "$head_commit" ]; then
    emit_context "Codebase Map Status: UPDATE_REQUIRED. The map describes commit ${map_commit}, while committed HEAD is ${head_commit}. Run /samsara:codebase-map. Uncommitted working-tree changes do not affect this state."
    exit 0
fi

# CURRENT — the map describes committed HEAD. Emit nothing.
exit 0
